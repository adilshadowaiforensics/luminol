<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LUMINOL" Width="1200" Height="820" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterScreen" Background="#101112" Foreground="#EDF1EA" FontFamily="./assets/fonts/#IBM Plex Sans" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" Tag="Ready">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#EDF1EA"/>
  <SolidColorBrush x:Key="Muted" Color="#B3BFBC"/>
  <SolidColorBrush x:Key="Panel" Color="#1D2423"/>
  <SolidColorBrush x:Key="Line" Color="#42534C"/>
  <SolidColorBrush x:Key="Cyan" Color="#95C8B7"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Small}"><Setter Property="FontFamily" Value="./assets/fonts/#IBM Plex Mono"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#95C8B7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#A7B8AC"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#DCCAAA"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B57929"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#285B50"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#95C8B7"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="ReadyOnly" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Ready"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RunningOnly" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Running"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ResultsOnly" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Results"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ErrorVisible" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ErrorOnly" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="#362421"/><Setter Property="BorderBrush" Value="#C69180"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B3BFBC"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#95C8B7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#95C8B7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#283630"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#B57929"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="TabStripPlacement" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="#42534C" BorderThickness="0,0,0,1"><WrapPanel IsItemsHost="True"/></Border>
   <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,18,0,0" TextElement.Foreground="#EDF1EA" TextElement.FontWeight="Normal"/>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ResultsTabStyle" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"/>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#A9B6AD" CornerRadius="3" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="StatusBadge" TargetType="TextBlock" BasedOn="{StaticResource Small}">
   <Setter Property="Background" Value="#3C3020"/><Setter Property="Foreground" Value="#E6BF7B"/><Setter Property="Padding" Value="8,4"/><Setter Property="Text" Value="Lifetime not measured"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="urgent"><Setter Property="Text" Value="At risk soon"/><Setter Property="Background" Value="#402923"/><Setter Property="Foreground" Value="#F0A395"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="rolling"><Setter Property="Text" Value="Disappearing over time"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="cloud"><Setter Property="Text" Value="In the vendor's cloud"/><Setter Property="Background" Value="#243541"/><Setter Property="Foreground" Value="#ABCFE6"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="stable"><Setter Property="Text" Value="Stays for now"/><Setter Property="Background" Value="#26392C"/><Setter Property="Foreground" Value="#ADD2AE"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="unreliable"><Setter Property="Text" Value="Not a reliable source"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="likely_gone"><Setter Property="Text" Value="Likely already gone"/></DataTrigger>
    <DataTrigger Binding="{Binding}" Value="hold"><Setter Property="Text" Value="Legal hold"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="ActionTemplate">
   <Border BorderBrush="#42534C" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,0,0,0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="24" Height="24" Background="#283630" CornerRadius="12" VerticalAlignment="Top"><TextBlock Text="↗" Foreground="#95C8B7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/></Border>
    <StackPanel Grid.Column="1"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Right" DataContext="{Binding status}" Style="{StaticResource StatusBadge}" VerticalAlignment="Top" Margin="16,0,0,0" MaxWidth="158"/><TextBlock Text="{Binding tool}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="{Binding text}" Foreground="#B3BFBC" Margin="0,7,0,0" LineHeight="22"/>
     <TextBlock Text="{Binding deadline, StringFormat='By {0:g}'}" Foreground="#F0A395" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="12" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding deadline}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding deadline}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="EvidenceTemplate">
   <Border BorderBrush="#42534C" BorderThickness="0,1,0,0" Padding="0,22" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="SOURCE" FontFamily="./assets/fonts/#IBM Plex Sans" FontSize="12" Foreground="#B3BFBC" Margin="0,0,0,12"/>    <TextBlock TextWrapping="Wrap" Text="{Binding tool}" Style="{StaticResource Small}"/>
    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Left"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Setter Property="Text" Value="Could not be checked"/><Style.Triggers><DataTrigger Binding="{Binding present}" Value="True"><Setter Property="Text" Value="Evidence found"/></DataTrigger><DataTrigger Binding="{Binding present}" Value="False"><Setter Property="Text" Value="Looked for, not found"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <WrapPanel><TextBlock Text="Source: " Style="{StaticResource Small}"/><TextBlock TextWrapping="Wrap" Text="{Binding source}" Foreground="#95C8B7" FontSize="12"/></WrapPanel>
    <ItemsControl ItemsSource="{Binding also_sources}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding}" Foreground="#95C8B7" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel><StackPanel Grid.Column="1">

    <Button Tag="EvidenceDetail" AutomationProperties.AutomationId="{Binding id}" AutomationProperties.Name="{Binding evidence}" HorizontalContentAlignment="Left" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,8"><Button.Content><TextBlock Text="{Binding evidence}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/></Button.Content></Button>
    <TextBlock TextWrapping="Wrap" Text="{Binding why}" Foreground="#B3BFBC"/>

    <Border Background="#283630" BorderBrush="#95C8B7" BorderThickness="2,0,0,0" Padding="14" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding clock}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
     <TextBlock DataContext="{Binding clock.status}" Style="{StaticResource StatusBadge}" HorizontalAlignment="Left"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding clock.headline}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,6"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding clock.deadline, StringFormat={}{0:g}}" Foreground="#F0A395"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding clock.detail}" Foreground="#EDF1EA" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <TextBlock TextWrapping="Wrap" Text="{Binding DataContext.lab_note, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Small}" Margin="0,12,0,10"/>
    <TextBlock TextWrapping="Wrap" Text="{Binding result.note}" Foreground="#E6BF7B"/>
    <TextBlock TextWrapping="Wrap" Text="{Binding action}" Margin="0,10,0,8"/>


    <ItemsControl ItemsSource="{Binding result.found_locations}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding}" Style="{StaticResource Small}" FontFamily="./assets/fonts/#IBM Plex Mono"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Grid></Border>
  </DataTemplate>
  </Window.Resources>
 <Grid x:Name="VisualRoot" Background="#101112">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Quiet brand frame; the evidence surface begins below it. -->
  <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="30" Height="30" BorderBrush="#B9A27B" BorderThickness="1" CornerRadius="3" Margin="0,0,13,0"><TextBlock Text="L" Foreground="#DCCAAA" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="LUMINOL" Foreground="#F1F1E9" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="/  AI EVIDENCE CHECK" Foreground="#A5B4B5" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SHADOW AI" Foreground="#DCCAAA" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="F O R E N S I C S" Foreground="#A5B4B5" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#171C1B" CornerRadius="8,8,0,0" Margin="16,0,16,0">
   <Grid Margin="28,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Ready: an operational scope sheet, with the single real command below. -->
    <ScrollViewer Style="{StaticResource ReadyOnly}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="8,36,8,28">
      <DockPanel><TextBlock Text="EXAMINATION / LOCAL WINDOWS ACCOUNT" Style="{StaticResource Eyebrow}"/><TextBlock Text="01 — PREPARE" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/></DockPanel>
      <TextBlock Text="Evidence has a lifetime." FontSize="42" FontWeight="SemiBold" Margin="0,24,0,10"/>
      <TextBlock Text="See what remains. Know what needs attention." FontSize="18" Foreground="#B3BFBC" Margin="0,0,0,32"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,32,0">
        <Border BorderBrush="#BBC7BD" BorderThickness="0,1,0,0" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" Style="{StaticResource Eyebrow}" Margin="0,3,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="Locate the traces" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Check known AI evidence locations in this Windows account." Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
        <Border BorderBrush="#42534C" BorderThickness="0,1,0,0" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" Style="{StaticResource Eyebrow}" Margin="0,3,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="Read the evidence clocks" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="See lifetime estimates, the source for each estimate, and what remains unmeasured." Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
        <Border BorderBrush="#42534C" BorderThickness="0,1,0,0" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" Style="{StaticResource Eyebrow}" Margin="0,3,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="Leave with a clear record" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review suggested actions and keep the HTML and JSON reports on this computer." Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
       </StackPanel>
       <Border Grid.Column="1" Background="#283630" CornerRadius="4" Padding="24" VerticalAlignment="Top"><StackPanel>
        <TextBlock Text="COLLECTION BOUNDARY" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Local by default.&#x0a;Explicit about limits." FontSize="23" FontWeight="SemiBold" LineHeight="30" Margin="0,16,0,20"/>
        <TextBlock Text="Reads file metadata and AI-site traces. Does not read conversation text or copy evidence." Foreground="#B3BFBC" FontSize="13" LineHeight="21"/>
        <Border BorderBrush="#C4D0C4" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0"><TextBlock Text="A missing result does not prove AI was not used. This check covers known locations in the current account." Style="{StaticResource Small}"/></Border>
       </StackPanel></Border>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer Style="{StaticResource RunningOnly}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="36,60,36,30">
     <TextBlock Text="02 / EXAMINATION IN PROGRESS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Reading the traces." FontSize="38" FontWeight="SemiBold" Margin="0,20,0,18"/><TextBlock Text="The current step is shown below. Findings will appear when the check finishes." FontSize="16" Foreground="#B3BFBC"/>
     <Border BorderBrush="#C4D0C4" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,20,0,0"><TextBlock Text="LUMINOL does not change the contents, size, dates or attributes of any file it checks — except that Windows may update the last-access time of files and folders it reads." Style="{StaticResource Small}"/></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ErrorVisible}"><Border x:Name="ErrorPanel" Style="{StaticResource ErrorOnly}" Margin="8,32"><StackPanel>
     <TextBlock Text="EXAMINATION INTERRUPTED" Foreground="#F0A395" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="11"/><TextBlock Text="The check could not finish." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,20"/><TextBlock x:Name="ErrorText"/><TextBlock Text="This is not a finding that no evidence exists. Review the error before checking again." Foreground="#F0A395" Margin="0,20,0,0"/><TextBlock x:Name="ReportPathText" Style="{StaticResource Small}" Margin="0,20,0,0"/>
    </StackPanel></Border></ScrollViewer>
    <Grid Style="{StaticResource ResultsOnly}" Margin="0,14,0,0">
    <Grid x:Name="ResultsOverview"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><TextBlock Text="EXAMINATION RECORD / RESULTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="LOCAL / WINDOWS" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/></DockPanel>
     <Border Grid.Row="1" Background="#283630" BorderBrush="#CCD6CC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="18,7"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="SummaryEvidence" Text="—" FontSize="24" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="1" Text="Evidence types found" Style="{StaticResource Small}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,2,0,0"/></Grid>
       <Grid Grid.Column="1" Margin="18,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="SummaryUrgent" Text="—" Foreground="#F0A395" FontSize="24" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="1" Text="At risk soon" Foreground="#F0A395" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,2,0,0"/></Grid>
       <Grid Grid.Column="2" Margin="18,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="SummaryServices" Text="—" FontSize="24" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="1" Text="Services seen" Style="{StaticResource Small}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,2,0,0"/></Grid>
       <Grid Grid.Column="3" Margin="18,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="SummaryCouldNotCheck" Text="—" FontSize="24" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="1" Text="Not fully checked" Style="{StaticResource Small}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,2,0,0"/></Grid>
      </Grid>
      <TextBlock x:Name="SummaryAbsenceNote" Foreground="#E6BF7B" FontSize="12" LineHeight="18" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel></Border>
        <TabControl x:Name="ResultsTabs" Style="{StaticResource ResultsTabStyle}" Grid.Row="2" Margin="0">
     <TabItem Header="01   Overview" AutomationProperties.Name="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Foreground="#EDF1EA"><StackPanel Margin="0,0,16,24"><TextBlock x:Name="RunSettingsText" TextWrapping="Wrap" Foreground="#E6BF7B" FontSize="13" Margin="0,0,0,0"/><TextBlock Text="Recommended actions" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="LabNoteText" Text="{Binding lab_note}" Style="{StaticResource Small}" LineHeight="20" Margin="0,0,0,12"/><ItemsControl x:Name="ActionsList" AlternationCount="1000" ItemTemplate="{StaticResource ActionTemplate}"/><TextBlock Text="No actions were supplied by this check. Review the findings and limits."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ActionsList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border BorderBrush="#CBD4CB" BorderThickness="1" Background="#283630" Padding="20" Margin="0,28,12,20"><StackPanel><TextBlock Text="OPTIONAL / REPORT TIMESTAMP" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TimestampText" Style="{StaticResource Small}" Margin="0,12,0,16"/><Button x:Name="TimestampButton" Content="Timestamp this report" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="02   Evidence" AutomationProperties.Name="Evidence"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Foreground="#EDF1EA"><StackPanel Margin="0,0,12,0"><TextBlock Text="Select a finding to see what it supports and what it does not establish." Style="{StaticResource Small}" Margin="0,2,0,0"/><ItemsControl x:Name="EvidenceList" ItemTemplate="{StaticResource EvidenceTemplate}"></ItemsControl></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="03   Sources &amp; limits" AutomationProperties.Name="Sources &amp; limits"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Foreground="#EDF1EA"><StackPanel Margin="0,0,12,0">
     <TextBlock Text="What this check cannot answer" Style="{StaticResource Heading}"/><ItemsControl x:Name="CannotAnswerList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#42534C" BorderThickness="0,0,0,1" Padding="0,12"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#EDF1EA"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Where the numbers come from" Style="{StaticResource Heading}" Margin="0,28,0,14"/><ItemsControl x:Name="SourcesList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding id}" Foreground="#95C8B7" FontWeight="SemiBold"/><TextBlock Text="{Binding kind}" Style="{StaticResource Small}" Margin="0,5,0,8"/><TextBlock Text="{Binding label}" TextWrapping="Wrap"/><TextBlock Text="{Binding url}" TextWrapping="Wrap" Foreground="#95C8B7" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Privacy" Style="{StaticResource Heading}" Margin="0,28,0,14"/><TextBlock x:Name="PrivacyText" Text="{Binding privacy}" TextWrapping="Wrap" Foreground="#B3BFBC"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="04   Draft notice" AutomationProperties.Name="Draft notice"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Foreground="#EDF1EA"><StackPanel Margin="0,0,12,0"><TextBlock Text="Draft preservation notice" Style="{StaticResource Heading}"/><TextBlock Text="A draft for your counsel to adapt. The complete notice is below." Style="{StaticResource Small}" Margin="0,0,0,18"/><Border Style="{StaticResource Card}" Padding="20"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="DRAFT / FOR COUNSEL" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="CopyNoticeButton" DockPanel.Dock="Right" Content="Copy complete notice" IsEnabled="False" Margin="16,0,0,0"/></DockPanel><Border BorderBrush="#BCC9C0" BorderThickness="0,1,0,0" Margin="0,16,0,14"/><TextBlock x:Name="HoldNoticeText" TextWrapping="Wrap" FontFamily="./assets/fonts/#IBM Plex Sans" FontSize="14" Foreground="#EDF1EA" LineHeight="21"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>

   </TabControl>
    </Grid>
    <Grid x:Name="EvidenceDetailView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10">
      <Button x:Name="BackToResultsButton" Content="&lt;- Back to results" HorizontalAlignment="Left" BorderThickness="0" Padding="0,4" MinHeight="30"/>
      <TextBlock x:Name="DetailSource" Style="{StaticResource Eyebrow}" Margin="0,4,0,3"/>
      <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock x:Name="DetailStatus" Style="{StaticResource Small}" Margin="0,5,0,0"/>
     </StackPanel>
     <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,16,20">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,28,0">
         <TextBlock Text="OBSERVED" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
         <ItemsControl x:Name="DetailObserved"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding label}" TextWrapping="Wrap" Style="{StaticResource Small}"/><TextBlock Grid.Column="1" Text="{Binding value}" TextWrapping="Wrap" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="WHAT IT SUPPORTS" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
         <TextBlock x:Name="DetailWhy" LineHeight="21"/>
         <TextBlock Text="DOES NOT ESTABLISH" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
         <TextBlock x:Name="DetailAbsence" Foreground="#E6BF7B" LineHeight="21" Margin="0,0,0,10"/>
         <TextBlock x:Name="DetailDoesNotEstablish" LineHeight="21"/>
         <StackPanel x:Name="DetailLifetime">
          <TextBlock Text="LIFETIME" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
          <TextBlock x:Name="DetailClockStatus" Style="{StaticResource StatusBadge}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="DetailClockHeadline" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/>
          <TextBlock x:Name="DetailClockDeadline" Foreground="#F0A395" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock x:Name="DetailClockDetail" LineHeight="21" Margin="0,4,0,0"/>
         </StackPanel>
         <TextBlock Text="NEXT ACTION" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
         <TextBlock x:Name="DetailAction" LineHeight="21"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="16">
         <StackPanel>
          <TextBlock Text="SOURCES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
          <ItemsControl x:Name="DetailSources"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="12" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="CHECK COMPLETED" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
          <TextBlock x:Name="DetailCompleted" Style="{StaticResource Small}"/>
          <TextBlock x:Name="DetailSettings" Foreground="#E6BF7B" FontSize="12" LineHeight="19" Margin="0,18,0,0"/>
          <TextBlock Text="{Binding lab_note}" Style="{StaticResource Small}" Margin="0,18,0,0"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border x:Name="DetailPartial" Background="#3C3020" BorderBrush="#E6BF7B" BorderThickness="2,0,0,0" Padding="16" Margin="0,24,0,0" Visibility="Collapsed"><StackPanel>
        <TextBlock Text="Coverage remains incomplete for this check" Foreground="#E6BF7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ItemsControl x:Name="DetailProblems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    </Grid>
    <!-- One persistent command, with report actions only when output exists. -->
    <Border Grid.Row="1" BorderBrush="#CCD6CC" BorderThickness="0,1,0,0" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="Ready to check" FontSize="12" Foreground="#B3BFBC" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Offline check · No administrator rights required" Style="{StaticResource ReadyOnly}" FontSize="11" Foreground="#B3BFBC" Margin="0,4,0,0"/><ProgressBar x:Name="ProgressBar" Style="{StaticResource RunningOnly}" Minimum="0" Maximum="100" Height="3" Margin="0,8,0,0" Foreground="#95C8B7" Background="#42534C" BorderThickness="0"/></StackPanel>
     <Button x:Name="CheckButton" Grid.Column="1" Content="Check this computer" Style="{StaticResource Primary}" Padding="22,9"/>
    </Grid></Border>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="30,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="INDEPENDENT AI FORENSICS" Foreground="#9FADAD" FontFamily="./assets/fonts/#IBM Plex Mono" FontSize="10" VerticalAlignment="Center"/>
   <Button x:Name="PreserveButton" Content="Preserve evidence" IsEnabled="False" Visibility="Collapsed"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEnabled, ElementName=OpenReportButton}" Value="False"/><Condition Binding="{Binding IsEnabled, ElementName=OpenFolderButton}" Value="False"/><Condition Binding="{Binding IsEnabled, ElementName=CopySummaryButton}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Button x:Name="OpenFolderButton" Content="Open folder" IsEnabled="False" BorderThickness="0" Foreground="#C6D1CE" Padding="12,6" MinHeight="32"/>
    <Button x:Name="CopySummaryButton" Content="Copy summary" IsEnabled="False" BorderThickness="0" Foreground="#C6D1CE" Padding="12,6" MinHeight="32" Margin="6,0,0,0"/>
    <Button x:Name="OpenReportButton" Content="Open full report  ↗" IsEnabled="False" BorderBrush="#60786E" Foreground="#EBF1E8" Padding="12,6" MinHeight="32" Margin="10,0,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
